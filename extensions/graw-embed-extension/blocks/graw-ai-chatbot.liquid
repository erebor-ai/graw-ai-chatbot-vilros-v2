<canvas id="confetti-canvas"></canvas>
<div id="flat-chat"></div>
<div id="voiceflow-chat-frame"></div>

<script type="text/javascript">
  function initializeGrawAISystems() {
    GrawLogger.log("GRAW AI: Initializing systems. Admin Preview Mode:", window.GRAW_AI_IS_ADMIN_PREVIEW);
    let dynamicStylesheetUri = undefined; // Default to undefined

    // Generate stylesheet string only if a custom base color is set, or if launcher text/icon/avatar is set.
    // The GrawAIStylesheetBuilder.buildCssString will return an empty string if no customizations are applicable.
    if (window.GRAW_AI_SETTINGS.chatBaseColor || window.GRAW_AI_SETTINGS.launcherText || window.GRAW_AI_SETTINGS.launcherIconUrl || window.GRAW_AI_SETTINGS.chatAvatarUrl) {
        if (typeof GrawAIStylesheetBuilder !== 'undefined' && GrawAIStylesheetBuilder.encodeStylesheetForVoiceflow) {
            const tempUri = GrawAIStylesheetBuilder.encodeStylesheetForVoiceflow(window.GRAW_AI_SETTINGS);
            if (tempUri && tempUri.startsWith('data:text/css;base64,')) {
                dynamicStylesheetUri = tempUri;
                GrawLogger.log("GRAW AI: Custom dynamic stylesheet generated for Voiceflow.");
            } else if (tempUri === "") { // Builder returned empty string intentionally
                 GrawLogger.log("GRAW AI: Stylesheet builder returned empty string (no specific overrides needed beyond defaults or GRAW base CSS). VF default theme will apply for palette if no base color.");
                 dynamicStylesheetUri = undefined; // Ensure it's undefined for VF
            } else {
                GrawLogger.log("GRAW AI: Stylesheet builder ran but produced invalid URI. VF default theme will apply for palette.");
                dynamicStylesheetUri = undefined; // Ensure it's undefined
            }
        } else {
            GrawLogger.warn('GRAW AI: Stylesheet Builder not ready. VF default theme will apply for palette.');
        }
    } else {
        GrawLogger.log("GRAW AI: No custom theme settings (base color, launcher text/icon, avatar) provided. Voiceflow will use its internal/dashboard theme.");
        // Ensure GRAW_AI_GENERATED_PALETTE is null if no custom theme attempt was made based on baseColor
        if (typeof GrawAIStylesheetBuilder !== 'undefined' && GrawAIStylesheetBuilder.generatePalette && !window.GRAW_AI_SETTINGS.chatBaseColor) {
            GrawAIStylesheetBuilder.generatePalette(null); // This will set window.GRAW_AI_GENERATED_PALETTE to null
        }
    }
    
    var v = document.createElement('script'),
      s = document.getElementsByTagName('script')[0];
    v.onload = function () {
      GrawLogger.log('GRAW AI: Voiceflow widget script (bundle.mjs) loaded.');
      if (
        typeof UserIdentifier === 'undefined' ||
        !UserIdentifier.getUserId ||
        typeof window.GRAW_AI_SETTINGS === 'undefined'
      ) {
        GrawLogger.error(
          'GRAW AI: Critical dependencies (UserIdentifier or GRAW_AI_SETTINGS) not loaded prior to VF init.'
        );
        return;
      }

      if (typeof UserIdentifier !== 'undefined' && UserIdentifier.maybeRegenerateId) {
        UserIdentifier.maybeRegenerateId();
      }      

      // UserID generation should happen regardless of admin preview for widget stability
      const userId = UserIdentifier.getUserId();
      const settings = window.GRAW_AI_SETTINGS;

      GrawLogger.log('GRAW AI: Preparing Voiceflow config with settings:', settings);

      const voiceflowConfig = {
        verify: { projectID: settings.voiceflowProjectID },
        url: 'https://general-runtime.voiceflow.com',
        versionID: 'production', // Consider making this a setting
        userID: userId,
        user: { name: settings.voiceflowSessionUserName },
        assistant: {
          banner: {
            title: settings.title,
            description: settings.description,
          },
          inputPlaceholder: settings.messagePlaceholder,
          persistence: 'sessionStorage',
          stylesheet: dynamicStylesheetUri || undefined, // Pass undefined if empty string
          extensions:
            !window.GRAW_AI_IS_ADMIN_PREVIEW
              ? [
                  // Only load extensions if not in admin preview
                  ConfettiExtension,
                  FileUploadExtension,
                  EmailVerificationExtension,
                  ShopifyOrderListExtension,
                  WaitingAnimationExtension,
                  GiftCardDisplayExtension,
                  DoneAnimationExtension,
                  FeedbackExtension,
                  OrderNumberExtension,
                  ItemTrackingExtension,
                  EmailInputExtension,
                  CancelItemExtension,
                  ReturnItemExtension,
                  ProactiveMessagesExtension,
                  CustomerDataExtension,
                  KlaviyoDataExtension,
                  AddToCartExtension,
                  CheckoutExtension,
                  PlaceholderExtension,
                  AbandonedCartExtension,
                  ClearProactiveExtension,
                  GoCheckoutExtension,
                  ContactFormExtension,
              ]
              : [], // Empty extensions array in admin
        },
        autostart: true,
        allowDangerousHTML: true,
      };
      GrawLogger.log('GRAW AI: Voiceflow config prepared:', JSON.parse(JSON.stringify(voiceflowConfig)));
      if (dynamicStylesheetUri)
        GrawLogger.log(
          'GRAW AI: Passing dynamic stylesheet to Voiceflow:',
          dynamicStylesheetUri.substring(0, 100) + '...'
        );

      window.voiceflow.chat
        .load(voiceflowConfig)
        .then(() => {
          GrawLogger.log('GRAW AI: Voiceflow chat.load().then() callback triggered.');
          if (window.GRAW_AI_IS_ADMIN_PREVIEW) {
            GrawLogger.log('GRAW AI: Admin preview mode - skipping GRAW AI handler initializations.');
            return;
          }
          GrawLogger.log('GRAW AI: Initializing GRAW AI handlers...');
          try {
            if (typeof window.GrawThemeManager !== 'undefined' && window.GrawThemeManager.init) window.GrawThemeManager.init();
            if (UserIdentifier.init) UserIdentifier.init();
            if (typeof customerIdentifier !== 'undefined' && customerIdentifier.init) customerIdentifier.init();
            if (typeof ProductVariableManager !== 'undefined' && ProductVariableManager.init) ProductVariableManager.init();
            if (typeof ProductPageEventHandler !== 'undefined' && ProductPageEventHandler.init) ProductPageEventHandler.init();
            if (typeof OutOfStockHandler !== 'undefined' && OutOfStockHandler.init) OutOfStockHandler.init();
            if (typeof EmailCaptureEventHandler !== 'undefined' && EmailCaptureEventHandler.init) EmailCaptureEventHandler.init();
            if (typeof CartPageEventHandler !== 'undefined' && CartPageEventHandler.init) CartPageEventHandler.init();
            if (typeof ProactiveCloseWatcher !== 'undefined' && ProactiveCloseWatcher.init) ProactiveCloseWatcher.init();
            if (typeof GiftCardAllocator !== 'undefined' && GiftCardAllocator.init) GiftCardAllocator.init();
            
            if (typeof window.GrawCheckoutTracker !== 'undefined' && window.GrawCheckoutTracker.init) {
              window.GrawCheckoutTracker.init();
            }

            // Initialize attribution tracking scripts
            if (typeof window.GrawCheckoutTracker !== 'undefined' && window.GrawCheckoutTracker.init) {
              GrawLogger.log('GRAW AI: Initializing checkout tracker...');
              window.GrawCheckoutTracker.init();
            }
            if (typeof window.SimpleAttributionTracker !== 'undefined' && window.SimpleAttributionTracker.init) {
              GrawLogger.log('GRAW AI: Initializing simple attribution tracker...');
              window.SimpleAttributionTracker.init();
            }

            ['unload', 'beforeunload'].forEach((event) => {
              window.addEventListener(event, () => {
                if (typeof GiftCardAllocator !== 'undefined' && GiftCardAllocator.cleanup) GiftCardAllocator.cleanup();
              });
            });
            GrawLogger.log('GRAW AI: All GRAW AI handlers initialized.');
          } catch (error) {
            GrawLogger.error('GRAW AI: Error initializing GRAW AI handlers:', error);
          }
        })
        .catch((error) => {
          GrawLogger.error('GRAW AI: Error during window.voiceflow.chat.load():', error);
        });
    }
    v.src = 'https://cdn.voiceflow.com/widget-next/bundle.mjs';
    v.type = 'text/javascript';
    s.parentNode.insertBefore(v, s);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGrawAISystems);
  } else {
    setTimeout(initializeGrawAISystems, 0); // Ensure deferred scripts have a chance
  }
</script>

{% schema %}
{
  "name": "GRAW AI Chatbot",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "⚙️ Core Setup"
    },
    {
      "type": "text",
      "id": "voiceflow_project_id",
      "label": "Project ID",
      "info": "Your unique Project ID. This is essential for the chatbot to function. If you don't have this, please contact GRAW.",
      //"default": ""
    },
    {
      "type": "text",
      "id": "klaviyo_public_key",
      "label": "Klaviyo Public API Key (Optional)",
      "info": "Enter your Klaviyo Public API Key if you use Klaviyo for email marketing."
      //"default": ""
    },
    {
      "type": "header",
      "content": "🎨 Chatbot Appearance & Text",
      "info": "Customize the look and feel of the chatbot."
    },
    {
      "type": "text",
      "id": "chat_title",
      "label": "Chatbot Title",
      "info": "The main title displayed at the top of the open chat widget (e.g., 'Customer Support' or your brand name).",
      "default": "AI Assistant"
    },
    {
      "type": "textarea",
      "id": "chat_description",
      "label": "Chatbot Description",
      "info": "A short description or welcome message displayed below the title in the chat widget.",
      "default": "How can I help you today?"
    },
    {
      "type": "text",
      "id": "launcher_text",
      "label": "Launcher Button Text",
      "info": "Custom text for the chat launcher button. Leave blank for default text.",
      "default": "Ask an Expert"
    },
    {
      "type": "image_picker",
      "id": "chat_avatar_image",
      "label": "Chatbot Avatar Image (Optional)",
      "info": "Appears in the chat header and welcome message. Recommended: square, ideally 80x80px or 100x100px."
    },
    {
      "type": "image_picker",
      "id": "launcher_icon_image",
      "label": "Launcher Button Icon (Optional)",
      "info": "Custom icon for the chat launcher. If not set, the default chat icon will be used. Recommended: small, square (e.g., 24x24px or 32x32px)."
    },
    {
      "type": "text",
      "id": "chat_message_placeholder",
      "label": "Message Input Placeholder",
      "info": "The placeholder text shown in the chat input field before the user types.",
      "default": "Ask me anything..."
    },
    {
      "type": "color",
      "id": "chat_base_color",
      "label": "Chat Base Color (for Palette)",
      "info": "Select a single base color. We'll generate a 10-shade palette to theme the chat widget. Leave blank/transparent to use the palette pre-configured by GRAW based on your brand colors.",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "header",
      "content": "💡 Behavioral & Incentive Settingss"
    },
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "min": 0,
      "max": 500,
      "step": 5,
      "label": "Free Shipping Threshold (Store's Main Currency Unit)",
      "unit": "$",
      "info": "The shopping cart value at which free shipping might be offered as an incentive. Adjust unit based on typical store currency.",
      "default": 100
    },
    {
      "type": "range",
      "id": "inactive_customer_months",
      "min": 1,
      "max": 24,
      "step": 1,
      "unit": "mon",
      "label": "Inactive Customer Period (Months)",
      "info": "Number of months without an order after which a customer is considered 'inactive' for targeted incentives.",
      "default": 3
    },
    {
      "type": "range",
      "id": "product_page_threshold_time",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "sec",
      "label": "Product Page Dwell Time for Proactive Message (Seconds)",
      "info": "How long (in seconds) a user should stay on a product page before a relevant proactive message appears.",
      "default": 15
    },
    {
      "type": "range",
      "id": "cart_page_threshold_time",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "sec",
      "label": "Cart Page Dwell Time for Proactive Message (Seconds)",
      "info": "How long (in seconds) a user should stay on the cart page before a cart-related proactive message appears.",
      "default": 5
    }
  ]
}
{% endschema %}
