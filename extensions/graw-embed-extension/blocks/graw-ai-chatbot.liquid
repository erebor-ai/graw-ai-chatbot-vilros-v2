{% comment %}
  GRAW AI Chatbot - App Embed Block v2
{% endcomment %}

{% liquid
  assign is_admin_preview = false
  if request.design_mode
    assign is_admin_preview = true
  endif

  assign default_brand_name_for_title = shop.name | split: ' ' | first
  assign product_page_threshold_ms = block.settings.product_page_threshold_time | times: 1000
  assign cart_page_threshold_ms = block.settings.cart_page_threshold_time | times: 1000

  comment 
    ============================================================================
    GRAW AI - CLIENT CONFIGURATION
    Set the proactive event sampling rate for this specific client here.
    0.2 = 20% chance of firing, 1.0 = 100% chance of firing.
    This value is updated by deploying the app extension (`shopify app deploy`).
    ============================================================================
  endcomment
  assign enable_debug_logging = false
  comment
    ============================================================================
    GRAW AI - DEVELOPER CONFIGURATION
    Set to `true` to enable console logs, `false` to disable for production.
    This is the master switch for the GrawLogger utility.
    ============================================================================
  endcomment
  assign client_specific_sampling_rate = 0.01
  assign event_sampling_rate_decimal = client_specific_sampling_rate

  assign chat_base_color_setting = block.settings.chat_base_color | default: '' | downcase
  assign use_custom_theme_palette = false
  if chat_base_color_setting != '' and chat_base_color_setting != 'transparent' and chat_base_color_setting != '#00000000' and chat_base_color_setting != '#0000' and chat_base_color_setting != 'rgba(0,0,0,0)'
    assign use_custom_theme_palette = true
  endif

  assign shop_identifier_for_vf_user = shop.permanent_domain | split: '.' | first | capitalize
  assign chat_avatar_image_url = block.settings.chat_avatar_image | image_url: width: 100

  assign launcher_icon_image_url = block.settings.launcher_icon_image | image_url: width: 64

  assign graw_klaviyo_key_from_settings = block.settings.klaviyo_public_key | default: ""
%}

{% comment %} The logger is now defined inline to avoid parser-blocking scripts and ensure it's available immediately. {% endcomment %}

<script>
  // --- GRAW Logger Utility ---
  (function(window) {
    'use strict';
    const GrawLogger = {
      _isLoggingEnabled: function() {
        // This check happens at call time, so GRAW_AI_SETTINGS will be defined.
        return window.GRAW_AI_SETTINGS?.enableDebugLogging === true;
      },
      log: function(...args) {
        if (this._isLoggingEnabled()) {
          console.log("GRAW AI:", ...args);
        }
      },
      warn: function(...args) {
        if (this._isLoggingEnabled()) {
          console.warn("GRAW AI:", ...args);
        }
      },
      error: function(...args) {
        // Errors are always logged regardless of the debug flag.
        console.error("GRAW AI Error:", ...args);
      },
      info: function(...args) {
        if (this._isLoggingEnabled()) {
          console.info("GRAW AI:", ...args);
        }
      },
    };
    window.GrawLogger = GrawLogger;
  })(window);
  // --- End GRAW Logger ---

  window.GRAW_AI_IS_ADMIN_PREVIEW = {{ is_admin_preview }};

  // IMPORTANT: Define GRAW_AI_SETTINGS *after* the logger is created,
  // but *before* the first call to GrawLogger.log that depends on it.
  window.GRAW_AI_SETTINGS = {
    // Settings from block.settings - these are always needed
    title: {{ block.settings.chat_title | default: default_brand_name_for_title | json }},
    description: {{ block.settings.chat_description | default: "How can I help you today?" | json }},
    messagePlaceholder: {{ block.settings.chat_message_placeholder | default: "Type your message..." | json }},
    launcherText: {{ block.settings.launcher_text | default: "Ask an Expert" | json }},
    chatAvatarUrl: {{ chat_avatar_image_url | json }},
    launcherIconUrl: {{ launcher_icon_image_url | json }},
    chatBaseColor: {% if use_custom_theme_palette %}{{ block.settings.chat_base_color | json }}{% else %}null{% endif %},
    voiceflowProjectID: {{ block.settings.voiceflow_project_id | json }},
    klaviyoPublicKey: {{ graw_klaviyo_key_from_settings | json }}, // JS still gets it via block.settings
    voiceflowSessionUserName: {{ shop_identifier_for_vf_user | default: "ShopUser" | prepend: "GRAW-" | json }},
    freeShippingThreshold: {{ block.settings.free_shipping_threshold | default: 100 | json }},
    inactiveCustomerMonths: {{ block.settings.inactive_customer_months | default: 6 | json }},
    productPageThresholdTime: {{ product_page_threshold_ms | default: 15000 | json }},
    cartPageThresholdTime: {{ cart_page_threshold_ms | default: 15000 | json }},
    eventSamplingRate: {{ event_sampling_rate_decimal | default: 1.0 | json }},
    enableDebugLogging: {{ enable_debug_logging | json }},

    // Settings from global Liquid objects - generally safe in admin, JS should handle if null/empty
    shopDomain: {{ shop.permanent_domain | json }},
    shopCurrency: {{ cart.currency.iso_code | default: "USD" | json }}, // Provide default for admin
    moneyFormat: {{ shop.money_format | json }},
    currencySymbol: {{ cart.currency.symbol | json }}
  };

  // Now it's safe to log.
  GrawLogger.log("Admin Preview Mode:", window.GRAW_AI_IS_ADMIN_PREVIEW);
  GrawLogger.log("GRAW AI: Settings populated:", JSON.parse(JSON.stringify(window.GRAW_AI_SETTINGS)));

  // Shopify context data - will be null/empty in admin for some, JS handlers need to be robust
  // These are populated here, but the scripts that heavily rely on them won't be loaded/initialized in admin mode.
  window.shopifyProduct = {% if product %}{{ product | json }}{% else %}null{% endif %};
  window.shopifyProductMetafields = {% if product %}{% raw %}{% endraw %}{ reviews:{rating:{{product.metafields.reviews.rating.value | default:'null'}},rating_count:{{product.metafields.reviews.rating_count | default:'null'}}},loox:{avg_rating:{{product.metafields.loox.avg_rating | default:'null'}},num_reviews:{{product.metafields.loox.num_reviews | default:'null'}}},okendo:{summaryData:{reviewAverageValue:{{product.metafields.okendo.summaryData.reviewAverageValue | default:'null'}},reviewCount:{{product.metafields.okendo.summaryData.reviewCount | default:'null'}}}},ba_rev:{review_data:{stars:{{product.metafields.ba_rev.review_data.stars | default:'null'}},reviews_count:{{product.metafields.ba_rev.review_data.reviews_count | default:'null'}}}},air_reviews_product:{review_avg:{{product.metafields.air_reviews_product.review_avg | default:'null'}},review_count:{{product.metafields.air_reviews_product.review_count | default:'null'}}} }{% raw %}{% endraw %}{% else %}null{% endif %};
  window.shopifyVariantData = {% if product %}{% raw %}{% endraw %}{ {% for variant in product.variants %}"{{ variant.id }}":{inventory_quantity:{{variant.inventory_quantity | default:0}},inventory_management:"{{variant.inventory_management}}",inventory_policy:"{{variant.inventory_policy}}"}{% unless forloop.last %},{% endunless %}{% endfor %} }{% raw %}{% endraw %}{% else %}null{% endif %};
  window.customerData = {% if customer %}{ isReturningVisitor:true,totalSpent:{{customer.total_spent | json}},totalOrders:{{customer.orders_count | json}},customer:{email:{{customer.email | json}},name:{{customer.name | json}},id:{{customer.id | json}},firstName:{{customer.first_name | json}},lastName:{{customer.last_name | json}},acceptsMarketing:{{customer.accepts_marketing | json}},orders:[{% for order in customer.orders limit:5 %}{id:{{order.id | json}},created_at:{{order.created_at | date:'%Y-%m-%dT%H:%M:%S%z' | json}}}{% unless forloop.last %},{% endunless %}{% endfor %}]} }{% else %}{isReturningVisitor:false,totalSpent:0,totalOrders:0,customer:null}{% endif %};
  window.Shopify = window.Shopify || {}; window.Shopify.customer = {% if customer %}{{customer | json}}{% else %}null{% endif %};
  window.shopifyCart = {% if cart %}{{ cart | json }}{% else %}null{% endif %}; // cart object might be null in admin
  window.shopifyCurrency = {symbol:{{cart.currency.symbol | json}},name:{{cart.currency.name | json}},code:{{cart.currency.iso_code | json}}};
</script>

